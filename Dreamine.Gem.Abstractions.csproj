<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Dreamine.Gem.Abstractions</AssemblyName>
    <RootNamespace>Dreamine.Gem.Abstractions</RootNamespace>
    <PackageId>Dreamine.Gem.Abstractions</PackageId>
    <Version>1.0.0</Version>
    <Authors>Dreamine Core Team</Authors>
    <Company>Dreamine</Company>
    <Description>Shared contracts for typed Dreamine GEM host and equipment capabilities.</Description>
    <PackageTags>dreamine;gem;abstractions;secs;contracts</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/CodeMaru-Dreamine/Dreamine.Gem.Abstractions</RepositoryUrl>
    <Title>Dreamine.Gem.Abstractions</Title>
    <Copyright>© 2026 Dreamine Core Team. All rights reserved.</Copyright>
    <PackageProjectUrl>https://github.com/CodeMaru-Dreamine/Dreamine.Gem.Abstractions</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Secs.Abstractions\Dreamine.Secs.Abstractions.csproj" />
  </ItemGroup>
</Project>
